generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String?
  createdAt    DateTime     @default(now())
  connections  Connection[]
  projects     Project[]
  crosswalks   Crosswalk[]
  exports      ExportHistory[]
}

model Connection {
  id               String    @id @default(cuid())
  userId           String
  name             String
  encryptedConnStr String
  iv               String
  authTag          String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pipelines        TransformationPipeline[]

  @@index([userId])
}

model Project {
  id          String       @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pipelines   TransformationPipeline[]

  @@index([userId])
}

model TransformationPipeline {
  id           String    @id @default(cuid())
  projectId    String
  connectionId String
  sourceTable  String
  sourceSchema String    @default("dbo")
  name         String
  config       Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  exports      ExportHistory[]

  @@index([projectId])
}

model Crosswalk {
  id        String   @id @default(cuid())
  userId    String
  name      String
  mappings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ExportHistory {
  id         String   @id @default(cuid())
  pipelineId String
  userId     String
  exportedAt DateTime @default(now())
  rowCount   Int
  status     String
  errorMsg   String?
  pipeline   TransformationPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pipelineId])
}
